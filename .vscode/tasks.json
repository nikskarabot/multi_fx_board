{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make STM32 Project",
            "type": "shell",
            "command": "make",
            "args": [
                "GCC_PATH=${config:stm32.gccPath}",
                "-j$(nproc)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}