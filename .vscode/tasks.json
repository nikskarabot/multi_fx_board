{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make STM32 Project",
            "type": "shell",
            "command": "make",
            "args": [
                "GCC_PATH=${userHome}/dev/tools/arm-gnu-toolchain-13.2.Rel1-x86_64-arm-none-eabi/bin",
                "-j$(nproc)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}