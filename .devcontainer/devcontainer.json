{
    "name": "ARM GCC Toolchain Environment",

    "build": {
        "dockerfile": "../tools/dockerfile"
    },
    
    // tells code editor to auto fix the UID/GID to match your local machine
    "updateRemoteUserUID": true,
    "remoteUser": "ubuntu",

    "runArgs": [
        "--device=/dev/bus/usb:/dev/bus/usb"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "marus25.cortex-debug",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}

